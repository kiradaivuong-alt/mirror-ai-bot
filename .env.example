# Copy to .env and fill locally. Never send real tokens in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# API Page ID verified in Meta Messenger settings and the Page's management links.
META_PAGE_ID=1244946622043732
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Copy the supported version selected in your Meta App, e.g. vXX.0
META_GRAPH_VERSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TOKEN=
# Defaults to a simulation: no messages go to Facebook or Telegram.
LIVE_SEND=false
HOST=127.0.0.1
PORT=8080
DB_PATH=data/bot.sqlite3
